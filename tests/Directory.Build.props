<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test names read as sentences on purpose: underscores are the point, not a slip. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2201;xUnit1051</NoWarn>
  </PropertyGroup>

</Project>
