<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>SafeInvest.App</RootNamespace>
    <AssemblyName>SafeInvest</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- A self-contained Windows App SDK app cannot be built without a runtime identifier,
         so default to x64 while still letting `dotnet publish -r win-arm64` override it.
         Note: no <Platforms> here — declaring it makes a solution build pick x86 as the
         PlatformTarget, which then contradicts the RID (NETSDK1032). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: the app runs from a folder, no certificate and no MSIX install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DefaultLanguage>fr-FR</DefaultLanguage>
    <!-- XAML-generated partial classes trip a few style analysers. -->
    <NoWarn>$(NoWarn);CA1852;CA1305;CA1304;CA1310;CA1720;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SafeInvest.Core/SafeInvest.Core.csproj" />
    <ProjectReference Include="../SafeInvest.MarketData/SafeInvest.MarketData.csproj" />
  </ItemGroup>

</Project>
