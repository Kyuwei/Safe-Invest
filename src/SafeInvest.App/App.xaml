<Application
    x:Class="SafeInvest.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SafeInvest.App.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:DirectionToBrushConverter x:Key="DirectionToBrush" />
            <converters:DirectionToSoftBrushConverter x:Key="DirectionToSoftBrush" />
            <converters:DirectionToGlyphConverter x:Key="DirectionToGlyph" />
            <converters:AssetKindToBrushConverter x:Key="AssetKindToBrush" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:GoalStatusToBrushConverter x:Key="GoalStatusToBrush" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
