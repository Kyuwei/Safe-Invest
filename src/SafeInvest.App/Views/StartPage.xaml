<Page
    x:Class="SafeInvest.App.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SafeInvest.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="48,36,48,48" RowSpacing="28" MaxWidth="1100" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bandeau d'accueil -->
            <Border Grid.Row="0" CornerRadius="20" Padding="36,32">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0" />
                        <GradientStop Color="#0EA5E9" Offset="0.55" />
                        <GradientStop Color="#10B981" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Spacing="12">
                    <TextBlock Text="Safe Invest"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Apprendre à investir avec de vrais cours et de l'argent qui ne l'est pas."
                               FontSize="19"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Opacity="0.95" />

                    <Border Background="#33000000"
                            CornerRadius="8"
                            Padding="12,7"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="White" />
                            <TextBlock Text="Argent fictif — aucune transaction réelle n'est jamais passée."
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Actions principales -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="OnNewGameClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="22,18"
                        CornerRadius="12"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Nouvelle partie" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Choisir un capital de départ et qui joue"
                                   FontSize="12"
                                   Opacity="0.85"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Click="OnSettingsClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="22,18"
                        CornerRadius="12">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Réglages" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Sources de données, clés API, affichage"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Click="OnHelpClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="22,18"
                        CornerRadius="12">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE897;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Comment ça marche ?" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Les bases en deux minutes"
                                   FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Parties enregistrées -->
            <StackPanel Grid.Row="2" Spacing="12">
                <TextBlock Text="Reprendre une partie" Style="{ThemeResource SafeInvestSectionTitleStyle}" />

                <Border Style="{ThemeResource SafeInvestCardStyle}"
                        Visibility="{x:Bind ViewModel.HasNoGames, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Aucune partie enregistrée pour l'instant."
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Lancez une nouvelle partie : vous recevrez un capital fictif à investir sur de vraies cryptos et actions."
                                   Style="{ThemeResource SafeInvestCaptionStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameCardItem">
                            <Button Click="OnResumeGameClick"
                                    Tag="{x:Bind Id}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="18,14"
                                    CornerRadius="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="22"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SafeInvestAccentBrush}">
                                        <TextBlock Text="{x:Bind PlayerLabel}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind PlayerName}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind DetailsText}"
                                                   Style="{ThemeResource SafeInvestCaptionStyle}" />
                                        <TextBlock Text="{x:Bind GoalText}"
                                                   Style="{ThemeResource SafeInvestCaptionStyle}"
                                                   Visibility="{x:Bind HasGoal, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind CashText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="disponible"
                                                   Style="{ThemeResource SafeInvestCaptionStyle}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
