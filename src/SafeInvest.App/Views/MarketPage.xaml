<Page
    x:Class="SafeInvest.App.Views.MarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SafeInvest.App.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock x:Name="TitleText" Text="Marché" Style="{ThemeResource SafeInvestSectionTitleStyle}" />

            <InfoBar x:Name="ObservationBar"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="False"
                     Title="Partie pilotée par une IA"
                     Message="Cet écran est en lecture seule : c'est l'IA qui passe les opérations, via MCP. Vous voyez ici ce qu'elle voit." />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="0"
                                PlaceholderText="Chercher une crypto, une action, un ETF…"
                                QueryIcon="Find"
                                QuerySubmitted="OnSearchSubmitted" />

                <muxc:ProgressRing Grid.Column="1" x:Name="LoadingRing" Width="20" Height="20" IsActive="False" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="AllChip" Content="Tout" IsChecked="True" Click="OnFilterClick" CornerRadius="16" Padding="16,6" />
                <ToggleButton x:Name="CryptoChip" Content="Cryptos" Click="OnFilterClick" CornerRadius="16" Padding="16,6" />
                <ToggleButton x:Name="StockChip" Content="Actions" Click="OnFilterClick" CornerRadius="16" Padding="16,6" />
                <ToggleButton x:Name="EtfChip" Content="ETF" Click="OnFilterClick" CornerRadius="16" Padding="16,6" />
            </StackPanel>
        </StackPanel>

        <InfoBar Grid.Row="1"
                 x:Name="MessageBar"
                 IsOpen="False"
                 IsClosable="True" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="AssetsList" Padding="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarketItem">
                        <Border Style="{ThemeResource SafeInvestCardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="42" Height="42"
                                        CornerRadius="10"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind Kind, Converter={StaticResource AssetKindToBrush}}">
                                    <TextBlock Text="{x:Bind KindLabel}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind Symbol}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SafeInvestCaptionStyle}" />
                                    <TextBlock Text="{x:Bind HoldingText}"
                                               Style="{ThemeResource SafeInvestCaptionStyle}"
                                               Foreground="{ThemeResource SafeInvestAccentBrush}"
                                               Visibility="{x:Bind IsHeld, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="130">
                                    <TextBlock Text="{x:Bind PriceText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Direction, Converter={StaticResource DirectionToGlyph}}"
                                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{x:Bind Direction, Converter={StaticResource DirectionToBrush}}" />
                                        <TextBlock Text="{x:Bind ChangeText}"
                                                   FontSize="13"
                                                   Foreground="{x:Bind Direction, Converter={StaticResource DirectionToBrush}}" />
                                        <TextBlock Text="sur 24 h" Style="{ThemeResource SafeInvestCaptionStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Content="Acheter / vendre"
                                        Click="OnTradeClick"
                                        Tag="{x:Bind Symbol}"
                                        VerticalAlignment="Center"
                                        CornerRadius="8"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
