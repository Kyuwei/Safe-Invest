<Page
    x:Class="SafeInvest.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bandeau de partie : qui joue, avec quoi, et l'état des cours -->
        <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource SafeInvestCardBorderBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="OnBackToMenuClick" Padding="10,6" ToolTipService.ToolTip="Retour au menu">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                </Button>

                <Border Grid.Column="1"
                        x:Name="PlayerBadge"
                        CornerRadius="8"
                        Padding="10,5"
                        Background="{ThemeResource SafeInvestAccentBrush}">
                    <TextBlock x:Name="PlayerBadgeText"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerNameText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValueText" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <muxc:ProgressRing x:Name="RefreshRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock x:Name="SourceNoteText"
                               Style="{ThemeResource SafeInvestCaptionStyle}"
                               VerticalAlignment="Center" />
                    <Button Click="OnRefreshClick" Padding="10,6" ToolTipService.ToolTip="Actualiser les cours">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <muxc:NavigationView x:Name="Navigation"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             OpenPaneLength="220"
                             SelectionChanged="OnNavigationSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Tableau de bord" Tag="dashboard">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="MarketItem" Content="Marché" Tag="market">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Historique" Tag="history">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Réglages" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Page>
