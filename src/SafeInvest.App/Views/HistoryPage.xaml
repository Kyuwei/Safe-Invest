<Page
    x:Class="SafeInvest.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SafeInvest.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Historique des opérations" Style="{ThemeResource SafeInvestSectionTitleStyle}" />
            <TextBlock x:Name="SummaryText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{ThemeResource SafeInvestCaptionStyle}" />
        </Grid>

        <Border Grid.Row="1" x:Name="EmptyCard" Style="{ThemeResource SafeInvestCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBlock Text="Aucune opération pour l'instant." FontWeight="SemiBold" />
                <TextBlock x:Name="EmptyHintText"
                           Style="{ThemeResource SafeInvestCaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="TradesList" Padding="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TradeItem">
                        <Border Style="{ThemeResource SafeInvestCardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Top"
                                        Background="{x:Bind Kind, Converter={StaticResource AssetKindToBrush}}">
                                    <TextBlock Text="{x:Bind SideLabel}"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                    <TextBlock FontSize="15" FontWeight="SemiBold">
                                        <Run Text="{x:Bind QuantityText}" />
                                        <Run Text="{x:Bind Symbol}" />
                                        <Run Text="à" />
                                        <Run Text="{x:Bind UnitPriceText}" />
                                    </TextBlock>
                                    <TextBlock Style="{ThemeResource SafeInvestCaptionStyle}">
                                        <Run Text="{x:Bind Name}" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind WhenText}" />
                                        <Run Text="·" />
                                        <Run Text="par" />
                                        <Run Text="{x:Bind ByLabel}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind FeesText}"
                                               Style="{ThemeResource SafeInvestCaptionStyle}"
                                               Visibility="{x:Bind FeesText, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind TotalText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind RealizedText}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{x:Bind Direction, Converter={StaticResource DirectionToBrush}}"
                                               Visibility="{x:Bind RealizedText, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <!-- La justification de l'IA : le cœur pédagogique de l'historique -->
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Background="{ThemeResource SafeInvestCardBorderBrush}"
                                        CornerRadius="8"
                                        Padding="12,9"
                                        Visibility="{x:Bind Rationale, Converter={StaticResource StringToVisibility}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Justification"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.7" />
                                        <TextBlock Text="{x:Bind Rationale}"
                                                   TextWrapping="Wrap"
                                                   FontStyle="Italic" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
