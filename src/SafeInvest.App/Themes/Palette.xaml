<!--
    Safe Invest's colour language.

    Green means "up", red means "down" — the first thing a beginner learns to read on a
    financial screen. Both are defined per theme so they stay legible on a light and on a
    dark background, and PaletteService can swap them for a blue/orange pair that survives
    the common forms of colour blindness.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SafeInvestUpColor">#15803D</Color>
            <Color x:Key="SafeInvestDownColor">#B91C1C</Color>
            <Color x:Key="SafeInvestFlatColor">#52525B</Color>
            <Color x:Key="SafeInvestUpSoftColor">#DCFCE7</Color>
            <Color x:Key="SafeInvestDownSoftColor">#FEE2E2</Color>

            <Color x:Key="SafeInvestAccentColor">#4F46E5</Color>
            <Color x:Key="SafeInvestCryptoColor">#F59E0B</Color>
            <Color x:Key="SafeInvestStockColor">#0EA5E9</Color>
            <Color x:Key="SafeInvestEtfColor">#8B5CF6</Color>
            <Color x:Key="SafeInvestAiColor">#7C3AED</Color>
            <Color x:Key="SafeInvestHumanColor">#0891B2</Color>

            <Color x:Key="SafeInvestCardColor">#FFFFFF</Color>
            <Color x:Key="SafeInvestCardBorderColor">#E4E4E7</Color>
            <Color x:Key="SafeInvestMutedColor">#71717A</Color>
            <Color x:Key="SafeInvestWarningColor">#B45309</Color>
            <Color x:Key="SafeInvestWarningSoftColor">#FEF3C7</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SafeInvestUpColor">#4ADE80</Color>
            <Color x:Key="SafeInvestDownColor">#F87171</Color>
            <Color x:Key="SafeInvestFlatColor">#A1A1AA</Color>
            <Color x:Key="SafeInvestUpSoftColor">#14532D</Color>
            <Color x:Key="SafeInvestDownSoftColor">#7F1D1D</Color>

            <Color x:Key="SafeInvestAccentColor">#818CF8</Color>
            <Color x:Key="SafeInvestCryptoColor">#FBBF24</Color>
            <Color x:Key="SafeInvestStockColor">#38BDF8</Color>
            <Color x:Key="SafeInvestEtfColor">#A78BFA</Color>
            <Color x:Key="SafeInvestAiColor">#A78BFA</Color>
            <Color x:Key="SafeInvestHumanColor">#22D3EE</Color>

            <Color x:Key="SafeInvestCardColor">#27272A</Color>
            <Color x:Key="SafeInvestCardBorderColor">#3F3F46</Color>
            <Color x:Key="SafeInvestMutedColor">#A1A1AA</Color>
            <Color x:Key="SafeInvestWarningColor">#FCD34D</Color>
            <Color x:Key="SafeInvestWarningSoftColor">#451A03</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="SafeInvestUpColor">#00FF00</Color>
            <Color x:Key="SafeInvestDownColor">#FF0000</Color>
            <Color x:Key="SafeInvestFlatColor">#FFFFFF</Color>
            <Color x:Key="SafeInvestUpSoftColor">#000000</Color>
            <Color x:Key="SafeInvestDownSoftColor">#000000</Color>

            <Color x:Key="SafeInvestAccentColor">#FFFF00</Color>
            <Color x:Key="SafeInvestCryptoColor">#FFFF00</Color>
            <Color x:Key="SafeInvestStockColor">#00FFFF</Color>
            <Color x:Key="SafeInvestEtfColor">#FF00FF</Color>
            <Color x:Key="SafeInvestAiColor">#FF00FF</Color>
            <Color x:Key="SafeInvestHumanColor">#00FFFF</Color>

            <Color x:Key="SafeInvestCardColor">#000000</Color>
            <Color x:Key="SafeInvestCardBorderColor">#FFFFFF</Color>
            <Color x:Key="SafeInvestMutedColor">#FFFFFF</Color>
            <Color x:Key="SafeInvestWarningColor">#FFFF00</Color>
            <Color x:Key="SafeInvestWarningSoftColor">#000000</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Brushes are what the views bind to; PaletteService rewrites these at runtime. -->
    <SolidColorBrush x:Key="SafeInvestUpBrush" Color="{ThemeResource SafeInvestUpColor}" />
    <SolidColorBrush x:Key="SafeInvestDownBrush" Color="{ThemeResource SafeInvestDownColor}" />
    <SolidColorBrush x:Key="SafeInvestFlatBrush" Color="{ThemeResource SafeInvestFlatColor}" />
    <SolidColorBrush x:Key="SafeInvestUpSoftBrush" Color="{ThemeResource SafeInvestUpSoftColor}" />
    <SolidColorBrush x:Key="SafeInvestDownSoftBrush" Color="{ThemeResource SafeInvestDownSoftColor}" />

    <SolidColorBrush x:Key="SafeInvestAccentBrush" Color="{ThemeResource SafeInvestAccentColor}" />
    <SolidColorBrush x:Key="SafeInvestCryptoBrush" Color="{ThemeResource SafeInvestCryptoColor}" />
    <SolidColorBrush x:Key="SafeInvestStockBrush" Color="{ThemeResource SafeInvestStockColor}" />
    <SolidColorBrush x:Key="SafeInvestEtfBrush" Color="{ThemeResource SafeInvestEtfColor}" />
    <SolidColorBrush x:Key="SafeInvestAiBrush" Color="{ThemeResource SafeInvestAiColor}" />
    <SolidColorBrush x:Key="SafeInvestHumanBrush" Color="{ThemeResource SafeInvestHumanColor}" />

    <SolidColorBrush x:Key="SafeInvestCardBrush" Color="{ThemeResource SafeInvestCardColor}" />
    <SolidColorBrush x:Key="SafeInvestCardBorderBrush" Color="{ThemeResource SafeInvestCardBorderColor}" />
    <SolidColorBrush x:Key="SafeInvestMutedBrush" Color="{ThemeResource SafeInvestMutedColor}" />
    <SolidColorBrush x:Key="SafeInvestWarningBrush" Color="{ThemeResource SafeInvestWarningColor}" />
    <SolidColorBrush x:Key="SafeInvestWarningSoftBrush" Color="{ThemeResource SafeInvestWarningSoftColor}" />

    <!-- Shared shapes so every card in the app looks like it belongs to the same family. -->
    <CornerRadius x:Key="SafeInvestCardCornerRadius">12</CornerRadius>
    <Thickness x:Key="SafeInvestCardPadding">18</Thickness>

    <Style x:Key="SafeInvestCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SafeInvestCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SafeInvestCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="SafeInvestSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SafeInvestCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SafeInvestMutedBrush}" />
    </Style>

</ResourceDictionary>
