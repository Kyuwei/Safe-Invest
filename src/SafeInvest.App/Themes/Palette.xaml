<!--
    Safe Invest's colour language.

    Green means "up", red means "down" — the first thing a beginner learns to read on a
    financial screen. The brushes are defined inside each theme dictionary, which is how
    WinUI resolves them per theme.

    Each up/down brush has an "Alt" twin in blue and orange. Roughly one man in twelve
    cannot reliably separate the usual green from the usual red, which on a financial
    screen means losing the single most important signal. PaletteLookup picks between the
    two sets, so nothing in the views has to know which palette is active.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SafeInvestUpBrush" Color="#15803D" />
            <SolidColorBrush x:Key="SafeInvestDownBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="SafeInvestFlatBrush" Color="#52525B" />
            <SolidColorBrush x:Key="SafeInvestUpSoftBrush" Color="#DCFCE7" />
            <SolidColorBrush x:Key="SafeInvestDownSoftBrush" Color="#FEE2E2" />

            <SolidColorBrush x:Key="SafeInvestUpAltBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="SafeInvestDownAltBrush" Color="#C2410C" />
            <SolidColorBrush x:Key="SafeInvestUpSoftAltBrush" Color="#DBEAFE" />
            <SolidColorBrush x:Key="SafeInvestDownSoftAltBrush" Color="#FFEDD5" />

            <SolidColorBrush x:Key="SafeInvestAccentBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="SafeInvestCryptoBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="SafeInvestStockBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="SafeInvestEtfBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="SafeInvestAiBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="SafeInvestHumanBrush" Color="#0891B2" />

            <SolidColorBrush x:Key="SafeInvestCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SafeInvestCardBorderBrush" Color="#E4E4E7" />
            <SolidColorBrush x:Key="SafeInvestMutedBrush" Color="#71717A" />
            <SolidColorBrush x:Key="SafeInvestWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="SafeInvestWarningSoftBrush" Color="#FEF3C7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SafeInvestUpBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="SafeInvestDownBrush" Color="#F87171" />
            <SolidColorBrush x:Key="SafeInvestFlatBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="SafeInvestUpSoftBrush" Color="#14532D" />
            <SolidColorBrush x:Key="SafeInvestDownSoftBrush" Color="#7F1D1D" />

            <SolidColorBrush x:Key="SafeInvestUpAltBrush" Color="#60A5FA" />
            <SolidColorBrush x:Key="SafeInvestDownAltBrush" Color="#FB923C" />
            <SolidColorBrush x:Key="SafeInvestUpSoftAltBrush" Color="#1E3A8A" />
            <SolidColorBrush x:Key="SafeInvestDownSoftAltBrush" Color="#7C2D12" />

            <SolidColorBrush x:Key="SafeInvestAccentBrush" Color="#818CF8" />
            <SolidColorBrush x:Key="SafeInvestCryptoBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SafeInvestStockBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="SafeInvestEtfBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="SafeInvestAiBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="SafeInvestHumanBrush" Color="#22D3EE" />

            <SolidColorBrush x:Key="SafeInvestCardBrush" Color="#27272A" />
            <SolidColorBrush x:Key="SafeInvestCardBorderBrush" Color="#3F3F46" />
            <SolidColorBrush x:Key="SafeInvestMutedBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="SafeInvestWarningBrush" Color="#FCD34D" />
            <SolidColorBrush x:Key="SafeInvestWarningSoftBrush" Color="#451A03" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SafeInvestUpBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestDownBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SafeInvestFlatBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SafeInvestUpSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SafeInvestDownSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="SafeInvestUpAltBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestDownAltBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SafeInvestUpSoftAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SafeInvestDownSoftAltBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="SafeInvestAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestCryptoBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestStockBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestEtfBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestAiBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SafeInvestHumanBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="SafeInvestCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SafeInvestCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SafeInvestMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SafeInvestWarningBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SafeInvestWarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared shapes so every card in the app looks like it belongs to the same family. -->
    <Style x:Key="SafeInvestCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SafeInvestCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SafeInvestCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="SafeInvestSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SafeInvestCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SafeInvestMutedBrush}" />
    </Style>

</ResourceDictionary>
