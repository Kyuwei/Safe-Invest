<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SafeInvest.Mcp</RootNamespace>
    <AssemblyName>SafeInvest.Mcp</AssemblyName>
    <!-- The MCP transport owns stdout; anything else printed there corrupts the protocol. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SafeInvest.Core/SafeInvest.Core.csproj" />
    <ProjectReference Include="../SafeInvest.MarketData/SafeInvest.MarketData.csproj" />
  </ItemGroup>

</Project>
